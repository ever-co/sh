{
  "name": "@ever-sh/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "ever.sh: run Ever products on your own infrastructure.",
  "type": "module",
  "scripts": {
    "content": "node tools/build-content.mjs",
    "dev": "node tools/build-content.mjs && vite dev",
    "build": "node tools/build-content.mjs && vite build",
    "start": "node serve.mjs",
    "typecheck": "node tools/build-content.mjs && tsc --noEmit",
    "test": "node tools/build-content.mjs && vitest run && node --test \"tools/*.test.mjs\""
  },
  "dependencies": {
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.2",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
