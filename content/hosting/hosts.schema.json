{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ever.sh/schemas/ever.hosting-targets.v1.json",
  "title": "Ever hosting targets snapshot",
  "description": "content/hosting/hosts.yaml, and each item of GET /v1/hosting-targets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "as_of", "targets"],
  "properties": {
    "schema": { "const": "ever.hosting-targets.v1" },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "product": {
      "enum": ["gauzy", "teams", "works", "rec", "traduora", "demand"]
    },
    "status": { "enum": ["available", "beta", "soon"] },
    "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "targetProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/product" },
        "status": { "$ref": "#/$defs/status" },
        "link": { "$ref": "#/$defs/url" }
      },
      "if": { "properties": { "id": { "const": "demand" } } },
      "then": { "properties": { "status": { "const": "soon" } } }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "summary_md",
        "products",
        "install_source",
        "snippet_kind",
        "referral",
        "order",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
        "kind": { "enum": ["ever_cloud", "self_host", "third_party"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "summary_md": { "type": "string", "minLength": 1, "maxLength": 400 },
        "requirements_md": { "type": "string", "maxLength": 800 },
        "docs_url": { "$ref": "#/$defs/url" },
        "badge": { "enum": ["one-click", "managed", "recommended"] },
        "products": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/targetProduct" }
        },
        "install_source": {
          "type": "string",
          "pattern": "^(cloud|self-hosted|ever\\.sh|partner:[a-z0-9-]{2,32})$"
        },
        "link_template": { "$ref": "#/$defs/url" },
        "snippet_kind": { "enum": ["compose", "env", "helm", "none"] },
        "referral": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["program", "param"],
              "properties": {
                "program": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
                "param": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,32}$" }
              }
            }
          ]
        },
        "order": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "status": { "$ref": "#/$defs/status" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "third_party" } } },
          "then": {
            "properties": { "install_source": { "type": "string", "pattern": "^partner:" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "ever_cloud" } } },
          "then": { "properties": { "install_source": { "const": "cloud" } } }
        }
      ]
    }
  }
}
