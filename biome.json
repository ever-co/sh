{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.output",
      "!**/.turbo",
      "!**/node_modules",
      "!apps/web/src/content.generated",
      "!tools/fixtures",
      "!apps/web/tools/fixtures",
      "!content/stats",
      "!!crates",
      "!!target",
      "!!deploy"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["tools/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off",
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    }
  ]
}
